# Porta em que a API sobe (Railway injeta automaticamente via PORT)
PORT=3001

# String de conexão do PostgreSQL (Railway injeta via DATABASE_URL)
DATABASE_URL=postgresql://usuario:senha@host:5432/tripcontrol

# Segredos JWT — gere strings aleatórias longas e diferentes entre si
JWT_SECRET=troque-por-uma-string-aleatoria-longa
JWT_REFRESH_SECRET=troque-por-outra-string-aleatoria-longa
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# URL do frontend em produção — usada no CORS e nos links de convite
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
EMAIL_FROM=

# Storage de uploads: local (disco em ./uploads) ou s3 (Cloudflare R2)
STORAGE_DRIVER=local

# Só necessários com STORAGE_DRIVER=s3
# Endpoint do R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=tripcontrol-public
S3_BUCKET_PRIVATE=tripcontrol-private
# URL pública do bucket de avatares (r2.dev ou domínio customizado), sem barra final
S3_PUBLIC_URL=